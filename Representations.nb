Cell[CellGroupData[{
Cell["The irreducible representations of the symmetric  group", "Title",
 CellChangeTimes->{{3.820266530441719*^9, 3.820266585472727*^9}, {
  3.8202765502390423`*^9, 
  3.8202765631339808`*^9}},ExpressionUUID->"de342e6a-a512-4e2d-872f-\
0c3353599caa"],

Cell["\<\
The Specht function gives the irreducible representation of the symmetric \
group, which is unique up to matrix similarity.\
\>", "Text",
 CellChangeTimes->{{3.8203510130799503`*^9, 3.820351028258172*^9}, 
   3.8213675077147493`*^9},ExpressionUUID->"ffe92f96-01f0-462c-b2e8-\
4a4e0dba41f5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Quiet", "[", 
   RowBox[{"<<", "Combinatorica`"}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"for", " ", "TransposeTableau"}], ",", " ", "Tableaux"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Tabloids", "[", "\[Lambda]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Tabloids", "[", "\[Lambda]", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Flatten", "@", 
         RowBox[{"Position", "[", 
          RowBox[{"#", ",", "i"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "@", "\[Lambda]"}]}], "}"}]}], "]"}], "&"}], "/@",
      "\[IndentingNewLine]", 
     RowBox[{"Permutations", "@", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"#", ",", 
           RowBox[{"\[Lambda]", "[", 
            RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "&"}], "/@", 
        RowBox[{"Range", "@", 
         RowBox[{"Length", "@", "\[Lambda]"}]}]}], "]"}]}]}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ColumnStabilizer", "[", "T_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", 
    RowBox[{"Transpose", "/@", 
     RowBox[{"Sort", "/@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"TransposeTableau", "@", "T"}], "]"}], ",", "#"}], "}"}],
           "]"}], "&"}], "/@", "\[IndentingNewLine]", 
        RowBox[{"(", 
         RowBox[{"Flatten", "/@", 
          RowBox[{"Tuples", "[", 
           RowBox[{"Permutations", "/@", 
            RowBox[{"TransposeTableau", "@", "T"}]}], "]"}]}], ")"}]}], 
       ")"}]}]}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Act", "[", 
    RowBox[{"\[Sigma]_", ",", "T_"}], "]"}], ":=", 
   RowBox[{"Sort", "/@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Sigma]", "[", 
        RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", "T"}], ")"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Kappa]", "[", "T_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Signature", "[", "#", "]"}], " ", ",", 
       RowBox[{"Act", "[", 
        RowBox[{"#", ",", "T"}], "]"}]}], "}"}], "&"}], "/@", 
    RowBox[{"ColumnStabilizer", "@", "T"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ToVector", "[", 
    RowBox[{"c_", ",", "T_"}], "]"}], ":=", 
   RowBox[{"c", " ", 
    RowBox[{"UnitVector", "[", 
     RowBox[{
      RowBox[{"Multinomial", "@@", 
       RowBox[{"Length", "/@", "T"}]}], ",", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"Tabloids", "[", 
          RowBox[{"Length", "/@", "T"}], "]"}], ",", "T"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Specht", "[", 
   RowBox[{"\[Lambda]_", ",", "\[Sigma]_"}], "]"}], ":=", 
  RowBox[{"Transpose", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"#", ".", 
      RowBox[{"PseudoInverse", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Plus", "@@", 
          RowBox[{"(", 
           RowBox[{"ToVector", "@@@", 
            RowBox[{"\[Kappa]", "[", "#", "]"}]}], ")"}]}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{"Reverse", "@", 
          RowBox[{"Tableaux", "@", "\[Lambda]"}]}], ")"}]}], "]"}]}], "&"}], "/@",
     "\[IndentingNewLine]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Plus", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"ToVector", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"Act", "[", 
              RowBox[{"\[Sigma]", ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}], "&"}], "/@", 
          RowBox[{"\[Kappa]", "[", "#", "]"}]}], ")"}]}], "&"}], "/@", 
      RowBox[{"(", 
       RowBox[{"Reverse", "@", 
        RowBox[{"Tableaux", "@", "\[Lambda]"}]}], ")"}]}], ")"}]}], 
   "]"}]}]}], "Input",
